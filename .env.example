# ==============================================================================
# Automated Loan Disbursement Scorecard — Environment Configuration Template
# (Copy this file to .env and replace placeholders with your actual credentials)
# ==============================================================================

# Application Environment
APP_ENV=development
ENVIRONMENT=development
APP_PORT=8000
IDP_PORT=8001
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
DEBUG=False

# Pipeline & Scorecard Configuration
# When True, all fields in all documents receive equal weight (1.0).
# When False (default), the tiered criticality weights (3.0, 2.0, 1.0) are applied.
USE_EQUAL_FIELD_WEIGHTS=false

# Fast-track pipeline bypass: Skip IDP OCR & LLM structuring when structured data is staged
SKIP_IDP=false

# Unified LLM Configuration (Google Gemini, OpenRouter, Groq, OpenAI)
# Examples:
#   Gemini:     LLM_API_KEY=AQ.xxx               LLM_MODEL=gemini-1.5-flash
#   OpenRouter: LLM_API_KEY=sk-or-v1-xxx         LLM_MODEL=deepseek/deepseek-chat
#   Groq:       LLM_API_KEY=gsk_xxx              LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://openrouter.ai/api/v1  # Optional: set for custom OpenAI endpoints
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Intelligent Document Processing (IDP) Microservice
OCR_ENGINE=rapidocr
OCR_MODEL=PP-OCRv6
OCR_CONFIDENCE_THRESHOLD=0.70
MAX_DOCUMENT_SIZE_MB=50
TEMP_DIR=/tmp/node2_idp

# HuggingFace Transformers Configuration (suppress deprecation warnings)
TRANSFORMERS_USE_FAST=1

# VLM Fallback Configuration ('gemini', 'openai', or 'mock')
VLM_ENABLED=False
VLM_PROVIDER=gemini
VLM_MODEL=gemini-3.6-flash
VLM_API_KEY=your_gemini_or_openai_api_key_here

# AWS / S3 Storage (Optional: Mock filesystem storage is used by default)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET=disbursement-documents
RAW_DOCUMENT_PREFIX=raw-documents/
PARSED_DOCUMENT_PREFIX=parsed-documents/
