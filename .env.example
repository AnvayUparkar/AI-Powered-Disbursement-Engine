# ==============================================================================
# Automated Loan Disbursement Scorecard — Environment Configuration Template
# (Copy this file to .env and replace placeholders with your actual credentials)
# ==============================================================================

# Application Environment
APP_ENV=development
ENVIRONMENT=development
APP_PORT=8000
IDP_PORT=8001
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
DEBUG=False

# Google Gemini API (Required for LLM Adjudication & VLM Fallbacks)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.0

# Intelligent Document Processing (IDP) Microservice
OCR_ENGINE=rapidocr
OCR_MODEL=PP-OCRv6
OCR_CONFIDENCE_THRESHOLD=0.70

# VLM Fallback Configuration ('gemini', 'openai', or 'mock')
VLM_ENABLED=True
VLM_PROVIDER=gemini
VLM_MODEL=gemini-3.6-flash
VLM_API_KEY=your_gemini_or_openai_api_key_here

# AWS / S3 Storage (Optional: Mock filesystem storage is used by default)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET=disbursement-documents

# OpenRouter LLM (Node 2 OCR → structured JSON field extraction)
# Get key from https://openrouter.ai/keys
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=google/gemini-2.0-flash-lite
