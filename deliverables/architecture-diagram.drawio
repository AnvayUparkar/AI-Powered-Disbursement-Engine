<mxfile host="app.diagrams.net" agent="dgcl-onboarding" version="24.7.0">
  <diagram id="architecture" name="architecture">
    <mxGraphModel dx="1800" dy="990" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="990" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="gL" value="Corporate network" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fafbfc;strokeColor=#8a97a6;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=15;container=1;collapsible=0;fontColor=#1f354d;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="900" as="geometry"/></mxCell>
        <mxCell id="gC" value="Kubernetes cluster - namespace: dgcl" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fafbfc;strokeColor=#8a97a6;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=15;container=1;collapsible=0;fontColor=#1f354d;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="1130" height="900" as="geometry"/></mxCell>
        <mxCell id="gR" value="LiteLLM (own infrastructure)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fafbfc;strokeColor=#8a97a6;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=15;container=1;collapsible=0;fontColor=#1f354d;" vertex="1" parent="1"><mxGeometry x="1510" y="20" width="270" height="900" as="geometry"/></mxCell>
        <mxCell id="user" value="Bank user&lt;br&gt;Browser (React UI)&lt;br&gt;sign-up / login" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="gL"><mxGeometry x="40" y="90" width="200" height="84" as="geometry"/></mxCell>
        <mxCell id="jump" value="Jump server&lt;br&gt;kubectl - helm - docker" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="gL"><mxGeometry x="40" y="310" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="registry" value="Internal container registry&lt;br&gt;dgcl-engine-backend&lt;br&gt;dgcl-engine-frontend&lt;br&gt;bitnami/redis" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="gL"><mxGeometry x="40" y="500" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="ingress" value="Ingress controller&lt;br&gt;nginx - TLS 443&lt;br&gt;/ to frontend, /api to api" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="40" y="80" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="frontend" value="frontend Deployment&lt;br&gt;nginx + React build&lt;br&gt;2 replicas - :8080" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="370" y="80" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="api" value="api Deployment&lt;br&gt;FastAPI (uvicorn, 2 workers)&lt;br&gt;1 replica (fixed, Recreate) - :8000&lt;br&gt;auth + tenant check on every route&lt;br&gt;runs the pipeline inline" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="364" y="235" width="262" height="130" as="geometry"/></mxCell>
        <mxCell id="worker" value="worker Deployment&lt;br&gt;Celery (threads, concurrency 4)&lt;br&gt;2 replicas - no port&lt;br&gt;each task runs as its tenant" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="370" y="430" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="idp" value="idp Deployment&lt;br&gt;Docling - RapidOCR - VLM client&lt;br&gt;2-10 replicas (HPA) - :8001&lt;br&gt;session or internal token" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="370" y="620" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="pvc" value="PVC&lt;br&gt;dgcl-engine-shared-poc-data&lt;br&gt;ReadWriteMany - 15Gi&lt;br&gt;/srv/app/poc_data holds:&lt;br&gt;.internal_token&lt;br&gt;tenants/&lt;id&gt;/ (case data)&lt;br&gt;mounted by api, worker, idp" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="50" y="330" width="240" height="380" as="geometry"/></mxCell>
        <mxCell id="authpvc" value="PVC dgcl-engine-auth-data&lt;br&gt;ReadWriteOnce - 1Gi&lt;br&gt;/srv/auth/auth.db (SQLite)&lt;br&gt;api only - kept on uninstall" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="50" y="207" width="240" height="118" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis (Bitnami, standalone)&lt;br&gt;:6379 - password auth&lt;br&gt;no persistence" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="760" y="240" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="scale" value="Scaling and availability&lt;br&gt;idp 2-10 (CPU 75%) - worker 2 - frontend 2&lt;br&gt;api fixed at 1 (SQLite accounts)&lt;br&gt;PDB on idp; none on api" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="751.5" y="570" width="317" height="110" as="geometry"/></mxCell>
        <mxCell id="cfg" value="Config injected as env vars&lt;br&gt;Secret dgcl-engine-secrets&lt;br&gt;(LLM, VLM keys, INTERNAL_API_TOKEN)&lt;br&gt;Secret dgcl-engine-redis-auth&lt;br&gt;ConfigMap dgcl-engine-config&lt;br&gt;TLS Secret dgcl-engine-tls (Ingress)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="35.5" y="730" width="319" height="150" as="geometry"/></mxCell>
        <mxCell id="acc" value="Access control&lt;br&gt;Sign-up / login, cookie session&lt;br&gt;(dgcl_session, 7 days)&lt;br&gt;Each signup = its own tenant&lt;br&gt;Internal token: api/worker to idp" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="gC"><mxGeometry x="760" y="750" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="models" value="Bedrock / Qwen 3.5&lt;br&gt;models served by LiteLLM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="gR"><mxGeometry x="30" y="130" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="litellm" value="LiteLLM gateway&lt;br&gt;https://tsguat1.hdbfs.com:560/v1&lt;br&gt;OpenAI-compatible API" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="gR"><mxGeometry x="16.5" y="360" width="247" height="130" as="geometry"/></mxCell>
        <mxCell id="legend" value="Solid arrows: runtime traffic.  Dashed arrows: deploy-time, volume mounts and config.  F1-F14 match the network flow table in the onboarding form.  Every tenant shares the same pods, Redis, shared volume and LiteLLM key." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="940" width="1700" height="30" as="geometry"/></mxCell>
