        <mxCell id="load" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="LOAD PROFILE   (assumed — confirm via SCALING_PLAN §9.1/§9.2)&#10;&#10;  10 cases per 30s poll   =  1,200 cases / hour&#10;  10 documents per case&#10;   6 pages per document&#10;  ------------------------------------------------&#10;  60 pages/case · 72,000 pages/hour · 20 pages/sec&#10;&#10;  TARGET: 30-40 s per case, end to end" vertex="1">
          <mxGeometry x="70" y="90" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="math" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" value="CAPACITY MATH   (at the measured 3.04 s/page)&#10;&#10;THROUGHPUT floor&#10;  one slot = 3600 / 3.04      = 1,184 pages/hour&#10;  72,000 / 1,184              =    61 slots&#10;&#10;LATENCY requirement&#10;  case wall clock ~25s, arrivals every 30s&#10;  =&gt; ~10 cases in flight x 10 docs each&#10;                              =   100 doc-slots&#10;&#10;SIZE FOR LATENCY — it dominates.  Throughput is&#10;then free (100 slots = 20k docs/h vs 12k needed)." vertex="1">
          <mxGeometry x="520" y="90" width="480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fleet" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" value="DERIVED FLEET   @ 3.04 s/page&#10;&#10;  IDP        100 doc-slots&#10;             -&gt; 25-50 pods  (c=2-4 per GPU)&#10;             -&gt; 25-50 GPU nodes&#10;  Reasoning  13 concurrent  -&gt; 2-4 pods (c=100)&#10;  Assembly   ~1 concurrent  -&gt; 2 pods (HA only)&#10;  API        3 pods&#10;  Ingestion  1 active (Lease) + 1 standby&#10;&#10;  Slots-per-GPU is the open variable: models are&#10;  ~400 MB so VRAM is not the limit, COMPUTE is." vertex="1">
          <mxGeometry x="1030" y="90" width="460" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cuda" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;" value="SAME FLEET @ 1.5 s/page   (CUDA — ESTIMATED)&#10;&#10;  a 6-page doc drops 18.2s -&gt; ~9s, so a slot&#10;  turns over twice as fast&#10;&#10;  IDP  -&gt; ~50 doc-slots -&gt; 13-25 GPU nodes&#10;  every other tier unchanged (none are the&#10;  bottleneck)&#10;&#10;  HALVES THE GPU BILL — the single biggest cost&#10;  lever. Verify before budgeting (§9.6, §9.7)." vertex="1">
          <mxGeometry x="1520" y="90" width="450" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pod_ing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;arcSize=6;" value="dgcl-ingestion            x1 active&#10;cmd: python -m pipeline.ingestion&#10;&#10;• polls DMS + LOS every 30s (+/- jitter)&#10;• joins on case_id, writes case_state&#10;• fingerprint + DB lease + dedupe&#10;• enqueues one task PER DOCUMENT&#10;&#10;node: CPU   port: none (egress only)" vertex="1">
          <mxGeometry x="70" y="305" width="360" height="145" as="geometry" />
        </mxCell>
