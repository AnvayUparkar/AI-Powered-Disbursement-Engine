        <mxCell id="ca" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;arcSize=6;" value="Cluster Autoscaler / Karpenter&#10;  GPU group scales AFTER KEDA marks pods Pending&#10;  node provision ~2-4 min + ~2 min image pull&#10;  =&gt; keep warm headroom; do not scale to the floor" vertex="1">
          <mxGeometry x="1010" y="1020" width="470" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lag" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;arcSize=6;" value="SCALE-UP LAG IS THE REAL RISK&#10;A 10x burst needs new GPU nodes: ~5 min before&#10;the first pod is Ready. Queue absorbs it only if&#10;the SLA tolerates ~5 min of backlog.&#10;Otherwise: over-provision the floor." vertex="1">
          <mxGeometry x="1510" y="1020" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dredis" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;boundedLbl=1;align=left;spacingLeft=8;" value="ElastiCache Redis  (cache.m6g.large, multi-AZ)&#10;  steady state depth ~0 — a rising depth IS the alert&#10;  burst: 100 messages per poll (10 cases x 10 docs)&#10;  alert on q.idp OLDEST AGE, not depth" vertex="1">
          <mxGeometry x="70" y="1212" width="450" height="105" as="geometry" />
        </mxCell>
        <mxCell id="drds" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;boundedLbl=1;align=left;spacingLeft=8;" value="RDS PostgreSQL  (db.t4g.medium, multi-AZ)&#10;  1,200 rows/hour = ~29k/day = ~10M/year&#10;  trivial load — this tier will never be the limit&#10;  sized for HA and audit retention, not throughput" vertex="1">
          <mxGeometry x="550" y="1212" width="450" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ds3" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;boundedLbl=1;align=left;spacingLeft=8;" value="S3&#10;  ~12 MB per case (raw + extracted + structured + result)&#10;  = ~14 GB/hour  ·  ~345 GB/day  ·  ~126 TB/year&#10;  LIFECYCLE POLICY IS MANDATORY: raw -&gt; IA at 30d,&#10;  Glacier at 90d. Results stay hot for the review UI." vertex="1">
          <mxGeometry x="1030" y="1212" width="470" height="105" as="geometry" />
        </mxCell>
        <mxCell id="dnote" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;" value="The only tier that grows without bound is S3.&#10;Everything else is steady-state.&#10;&#10;Budget the object count too, not just bytes:&#10;~50 objects/case = 60k/hour = 500M/year." vertex="1">
          <mxGeometry x="1530" y="1212" width="440" height="105" as="geometry" />
        </mxCell>
        <mxCell id="bl1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;arcSize=6;" value="1 · GPU node count&#10;The binding constraint and ~all of the cost.&#10;74% of per-page time is OCR (§1.5) and it is&#10;the only stage still on CPU. Fix that first and&#10;this ladder shifts by one rung." vertex="1">
          <mxGeometry x="70" y="1400" width="370" height="125" as="geometry" />
        </mxCell>
        <mxCell id="bl2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;arcSize=6;" value="2 · LLM provider rate limit&#10;12,000 documents/hour of extraction calls.&#10;At 1 call/doc that is 3.3 req/s sustained —&#10;check the tier limit. Batching 5-10 docs per&#10;call drops it to ~0.5 req/s." vertex="1">
          <mxGeometry x="465" y="1400" width="370" height="125" as="geometry" />
        </mxCell>
        <mxCell id="bl3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;arcSize=6;" value="3 · Scale-up lag, not capacity&#10;~5 min from burst to first Ready GPU pod.&#10;A spiky arrival pattern hits this long before&#10;it hits steady-state capacity." vertex="1">
          <mxGeometry x="860" y="1400" width="370" height="125" as="geometry" />
        </mxCell>
        <mxCell id="bl4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;arcSize=6;" value="4 · S3 object count / lifecycle&#10;~500M objects/year. Not a throughput limit,&#10;but a cost and listing-performance problem&#10;if no lifecycle policy exists." vertex="1">
          <mxGeometry x="1255" y="1400" width="350" height="125" as="geometry" />
        </mxCell>
        <mxCell id="bl5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;" value="NOT bottlenecks&#10;  Postgres — trivial load&#10;  Redis — steady depth ~0&#10;  API / assembly tiers — milliseconds&#10;  Ingestion — 2 API calls per 30s" vertex="1">
