          <mxGeometry x="455" y="305" width="360" height="145" as="geometry" />
        </mxCell>
        <mxCell id="pod_rea" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=6;verticalAlign=top;spacingTop=5;arcSize=6;" value="dgcl-reasoning             x2-4&#10;cmd: celery worker -Q q.reason&#10;     -c 100 --pool=gevent&#10;&#10;• LLM sanitise + doc-type classify&#10;• Gemini VLM fallback on weak regions&#10;• batches 5-10 docs per API call&#10;&#10;node: CPU   port: none   ~50 MB" vertex="1">
